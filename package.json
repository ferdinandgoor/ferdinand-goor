{
  "name": "protolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^8.16.2",
    "@react-three/postprocessing": "^2.16.2",
    "@types/three": "^0.164.0",
    "is-mobile": "^4.0.0",
    "phosphor-react": "^1.4.1",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.23.1",
    "react-scroll-parallax": "^3.4.2",
    "react-vfx": "^0.5.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8",
    "sass-embedded": "^1.102.0",
    "typescript": "^5",
    "vite": "^5.4.2",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
